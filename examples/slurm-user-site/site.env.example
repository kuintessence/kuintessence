# 可信的 Bash 配置文件；真实地址只填在集群上的 site.env，不回传、不提交。
# 2026-11-11：所有云端流量经 SSH 隧道；别名从 ~/.ssh/config 读取。
export KQ_SSH_HOST="${KQ_SSH_HOST:-kq-service}"
# 每行 本地端口:云端可达目标主机:目标端口；目标由 kq-service 视角解释。
# 必须按实际监听填写；不要猜远端端口。示例只展示格式：
# export KQ_TUNNEL_FORWARDS='18443:127.0.0.1:443
# 19443:127.0.0.1:9443
# 19000:127.0.0.1:9000'
export KQ_TUNNEL_FORWARDS="${KQ_TUNNEL_FORWARDS:-}"
# curl 预检强制经该本地隧道端口连接，保留 URL 的 Host/SNI。
export KQ_HTTP_LOCAL_PORT="${KQ_HTTP_LOCAL_PORT:-18443}"
# 私有 CA 可选；curl 的信任不等于 CLI/Agent 已完成信任配置。
export KQ_TLS_CA_FILE="${KQ_TLS_CA_FILE:-}"

# 没有填写地址时可以先做本地预检。仅用于 path 路由部署的 HTTP 默认值：
export KQ_ORIGIN="${KQ_ORIGIN:-}"
export SERVER_HTTP_URL="${SERVER_HTTP_URL:-${KQ_ORIGIN:+${KQ_ORIGIN%/}/platform}}"
# HTTP/2 + mTLS 入口可能有独立域名或端口，必须单独填写。
export SERVER_GRPC_URL="${SERVER_GRPC_URL:-}"

export KQ_SHARED="${KQ_SHARED:-$HOME/kq-test}"
# 留空直到确认可写、持久且不在共享文件系统上的本地目录。
# 不可放HOME、KQ_SHARED、/tmp、/var/tmp、/run或/dev/shm下；本地FS不代表保留策略已获确认。
export KQ_LOCAL="${KQ_LOCAL:-}"
export KQ_PARTITION="${KQ_PARTITION:-cn}"
# 留空则不指定 account/QoS，使用站点默认值；提交失败后按真实信息补齐。
export KQ_ACCOUNT="${KQ_ACCOUNT:-}"
export KQ_QOS="${KQ_QOS:-}"
export KQ_QUEUE_ID="${KQ_QUEUE_ID:-}"

# 登录 shell 已定义 module 时可留空；否则填写实际初始化文件的绝对路径。
export KQ_MODULE_INIT="${KQ_MODULE_INIT:-}"
export KQ_PYTHON_MODULE="${KQ_PYTHON_MODULE:-bio-python/3.11-2026.07.24}"
export KQ_APPTAINER_MODULE="${KQ_APPTAINER_MODULE:-apptainer/1.5.3}"
# 可选：只探测显式选择的编译器/MPI；空值不加载，inventory记为not-tested。
export KQ_SMOKE_COMPILER_MODULE="${KQ_SMOKE_COMPILER_MODULE:-}"
export KQ_SMOKE_COMPILER_COMMAND="${KQ_SMOKE_COMPILER_COMMAND:-cc}"
export KQ_SMOKE_MPI_MODULE="${KQ_SMOKE_MPI_MODULE:-}"
export KQ_SMOKE_MPI_COMMAND="${KQ_SMOKE_MPI_COMMAND:-mpirun}"
# 首次 0；接管演练改为 90，范围 0..120 秒。
export KQ_SMOKE_SLEEP_SEC="${KQ_SMOKE_SLEEP_SEC:-0}"

# 新版初始化入口使用以下配置。云端须先部署 site-gateway 和签名发行接口。
export KQ_TRANSPORT_MODE="${KQ_TRANSPORT_MODE:-ssh-forward}"
# 示例格式：18443:127.0.0.1:18443；填写真实云端统一 TLS 入口。
export KQ_GATEWAY_FORWARD="${KQ_GATEWAY_FORWARD:-}"
# http-proxy 模式：18080:127.0.0.1:3128，目标须是已部署的 CONNECT 代理。
export KQ_PROXY_FORWARD="${KQ_PROXY_FORWARD:-}"
export KQ_EXTRA_FORWARDS="${KQ_EXTRA_FORWARDS:-}"
export KQ_ALLOWED_ORIGINS="${KQ_ALLOWED_ORIGINS:-}"
export KQ_RELEASE_CHANNEL="${KQ_RELEASE_CHANNEL:-stable}"
# 平台经可信渠道提供的 Ed25519 公钥 PEM；用单引号包住多行 PEM。
export KQ_RELEASE_PUBLIC_KEY_PEM="${KQ_RELEASE_PUBLIC_KEY_PEM:-}"
# 首轮 modules 验证用 0；平台发布本站 runtime-sif/site-profile/spack 后置 1。
export KQ_ENABLE_SPACK="${KQ_ENABLE_SPACK:-0}"
# 托管安装内存预算 1024..1048576 MiB（1 TiB安全上界）；Slurm 预留 max(2048,预算)+512 MiB。
# 按软件实际峰值及节点 RealMemory 选择；调度能放下不代表编译内存足够。
# 云端samtools测试2048曾OOM，2816预算/3328申请成功；不是本站通用最低值。
export KQ_SPACK_MANAGED_MEMORY_MIB="${KQ_SPACK_MANAGED_MEMORY_MIB:-4096}"
# 安装超时毫秒 60000..86400000，默认 6 小时；须不超过实际 partition 时限。
# partition 上限 30 分钟时设置 1800000，避免 Pending PartitionTimeLimit。
export KQ_SPACK_INSTALL_TIMEOUT_MS="${KQ_SPACK_INSTALL_TIMEOUT_MS:-21600000}"
# 已确认本地端口属于 kq-tunnel 服务时置 1。
export KQ_REUSE_TUNNEL="${KQ_REUSE_TUNNEL:-0}"

# 首次注册默认终端隐藏输入；也可填权限0600的token文件，或 - 从标准输入读取。
# 只填写路径，不把token正文写进配置。已有身份时不再消费token。
export KQ_REGISTRATION_TOKEN_FILE="${KQ_REGISTRATION_TOKEN_FILE:-}"

# doctor/install 自动从已注册证书获取短期诊断fixture，不复用Agent长驻流。
# 注册前可只查一次性token的metadata；不消费token。不在命令行传token。
export KQ_DOCTOR_TOKEN_FILE="${KQ_DOCTOR_TOKEN_FILE:-}"
# 仅供已有独立测试fixture的兼容入口；通常留空，平台自动签发。
export KQ_DOCTOR_FIXTURES_FILE="${KQ_DOCTOR_FIXTURES_FILE:-}"
# install 在共享盘自动生成 helpers/modules-smoke.sh，无须单独上传。

# 文件系统空间保留量（字节）；statvfs不代表用户配额，配额仍由站点确认。
export KQ_LOCAL_RESERVE_BYTES="${KQ_LOCAL_RESERVE_BYTES:-1073741824}"
export KQ_SHARED_RESERVE_BYTES="${KQ_SHARED_RESERVE_BYTES:-2147483648}"
# 默认只提供清理预览；启用后每天仅在本地账本和Slurm均空闲时短暂停止Agent并清理。
export KQ_AUTOMATIC_GC="${KQ_AUTOMATIC_GC:-0}"

# 由站点确认本地状态目录不会在退出登录/重启/定期清理时丢失；未知保持0。
export KQ_LOCAL_RETENTION_CONFIRMED="${KQ_LOCAL_RETENTION_CONFIRMED:-0}"
# 仅当站点已批准替代 user-systemd/linger 的长期监督器时设置1。
export KQ_APPROVED_SUPERVISOR_CONFIRMED="${KQ_APPROVED_SUPERVISOR_CONFIRMED:-0}"
# 计算节点 modules-smoke 产生的 result.json 绝对路径；受管安装要求24小时内记录。
export KQ_COMPUTE_INVENTORY_FILE="${KQ_COMPUTE_INVENTORY_FILE:-}"
# 执行能力探测所用的可信 runtime SIF 绝对路径；须与发行绑定的SIF字节相同。
export KQ_CAPABILITY_SIF_PATH="${KQ_CAPABILITY_SIF_PATH:-}"
# 计算节点可写scratch目录及软件需要的最小空闲MiB（默认20GiB，按软件调大）。
export KQ_COMPUTE_SCRATCH="${KQ_COMPUTE_SCRATCH:-}"
export KQ_SPACK_SCRATCH_MIN_MIB="${KQ_SPACK_SCRATCH_MIN_MIB:-20480}"
# 本站partition/account/QoS单作业内存上限MiB，由站点核实；必须容纳max(2048,预算)+512。
export KQ_SLURM_MEMORY_LIMIT_MIB="${KQ_SLURM_MEMORY_LIMIT_MIB:-}"

# 希望Agent离线后仍能恢复作业身份的秒数（60..604800）；检查accounting/MinJobAge，只报告不修改。
export KQ_RECOVERY_WINDOW_SEC="${KQ_RECOVERY_WINDOW_SEC:-86400}"
