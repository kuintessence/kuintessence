# Copy to the private edge/ directory. Replace the three DNS names and provide TLS files.
server {
  listen 443 ssl;
  server_name platform.site.example;
  ssl_certificate /run/kq-edge/tls/server.crt;
  ssl_certificate_key /run/kq-edge/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 128m;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  location /platform/api/ {
    rewrite ^/platform(/.*)$ $1 break;
    proxy_pass http://server:3000;
    proxy_cookie_path /api/auth/oidc /platform/api/auth/oidc;
    proxy_cookie_path /api/auth /platform/api/auth;
  }
  location /platform/ws/ {
    rewrite ^/platform(/.*)$ $1 break;
    proxy_pass http://server:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
  }
  location /software/api/ {
    rewrite ^/software/(.*)$ /$1 break;
    proxy_pass http://registry:3100;
    proxy_request_buffering off;
    proxy_read_timeout 1800s;
  }
  location /v2/ { proxy_pass http://registry:3100; }
  location /buildcache/ { proxy_pass http://registry:3100; }
  location / { proxy_pass http://web:80; }
}
server {
  listen 443 ssl;
  server_name sso.site.example;
  ssl_certificate /run/kq-edge/tls/server.crt;
  ssl_certificate_key /run/kq-edge/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  location / {
    proxy_pass http://casdoor:8000;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
  }
}
server {
  listen 443 ssl;
  server_name storage.site.example;
  ssl_certificate /run/kq-edge/tls/server.crt;
  ssl_certificate_key /run/kq-edge/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 1g;
  location / {
    proxy_pass http://rustfs:9000;
    proxy_set_header Host $http_host;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 900s;
  }
}
