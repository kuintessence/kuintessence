# Merge with deploy/main/env.example and deploy/federation/env.example in a private 0600 file.
# These are placeholders; use independent values and files for each institution.
KQ_AIO_PRIVATE_DIRECTORY=/etc/kuintessence-aio/site-a
KQ_AIO_AGENT_ID=site-a-slurm
KQ_AIO_CLUSTER_NAME=Site A Slurm
KQ_AIO_SCHEDULER_MEMORY=384m
# Drain the initial software-directory permission projection without bypassing enforce.
AUTHZ_OUTBOX_INTERVAL_SEC=1
# Only with config --managed: scheduler + user manager + bounded installation worker.
KQ_AIO_MANAGED_MEMORY=2560m
KQ_AIO_MANAGED_STORE_BYTES=2147483648
KQ_AIO_BIND=127.0.0.1
KQ_AIO_HTTPS_PORT=443
KQ_AIO_PUBLIC_HOST=platform.site.example
KQ_AIO_SSO_HOST=platform.site.example
KQ_AIO_STORAGE_HOST=platform.site.example
KQ_STORAGE_PUBLIC_URL=https://platform.site.example
# WEB_BASE_URL, SSO_BOOTSTRAP_ISSUER_URL and Casdoor origin use this same origin.
# Casdoor: basePath=/sso; originFrontend and staticBaseUrl=<origin>/sso.
# Keep SSO_BOOTSTRAP_REDIRECT_URI at /platform/api/auth/oidc/callback.
KQ_DATA_MARKET_COMMITTER_ACCESS_KEY=
KQ_DATA_MARKET_COMMITTER_SECRET_KEY=
KQ_CASDOOR_POSTGRES_PASSWORD=
# R uses independent files and ports, e.g. HTTPS 8443, Gateway 3444, Peer 8051,
# Web 8081, Server HTTP/RPC 3010/3011, RustFS 9100/9101, SSO 15181.

# Network input/result transfer is opt-in. Use explicit HTTPS storage origins and a byte budget.
# Each staging directory is retained in scheduler-state, mode 0700, owned by the Agent
# (kq in managed mode). A change of execution identity requires explicit data maintenance.
# Managed runtime may instead set these string values in runtime/agent.json; leave Compose null then.
# If both sources opt in, their JSON objects must match; a conflict refuses startup.
AGENT_FEDERATION_INPUT_COPY=null
AGENT_FEDERATION_RESULT_COPY=null
# AGENT_FEDERATION_INPUT_COPY='{"stagingRoot":"/var/lib/kuintessence/federation-input","maxStagingBytes":67108864,"allowedSourceOrigins":["https://storage.source.example"],"allowedDestinationOrigins":["https://storage.destination.example"]}'
# AGENT_FEDERATION_RESULT_COPY='{"stagingRoot":"/var/lib/kuintessence/federation-result","maxStagingBytes":67108864,"allowedSourceOrigins":["https://storage.source.example"],"allowedDestinationOrigins":["https://storage.destination.example"]}'

# Experimental member permissions; explicit grants remain individually revocable.
FEDERATION_PERMISSION_PRESET=lab
