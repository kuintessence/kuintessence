# Loaded as /etc/nginx/nginx.conf; nginx:1.27-alpine includes stream statically.
events {}
stream {
  resolver 127.0.0.11 valid=30s ipv6=off;
  map $ssl_preread_server_name $site_backend {
    ${PLATFORM_HOST} ${HTTP_GATEWAY_UPSTREAM};
    ${AGENT_HOST} ${AGENT_MTLS_UPSTREAM};
    default 127.0.0.1:1;
  }
  server {
    listen 443;
    ssl_preread on;
    proxy_connect_timeout 15s;
    proxy_timeout 24h;
    proxy_pass $site_backend;
  }
}
