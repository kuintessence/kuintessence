# Kuintessence Agent. Install at /etc/kq-agent/kq-agent.env.
# Use the URLs and identity from the registration output.
SERVER_GRPC_URL=https://agent.example.invalid
SERVER_HTTP_URL=https://server.example.invalid/platform
AGENT_ID=agent-site-a
AGENT_SITE_NAME=site-a

AGENT_SPAWNER_BACKEND=host
AGENT_DB_PATH=/var/lib/kq-agent/agent.db
HEARTBEAT_INTERVAL_SEC=30
AGENT_QUEUE_INVENTORY_INTERVAL_SEC=30
LOG_LEVEL=info

# Register with the kq CLI before starting the service.
# This directory contains client.crt, client.key and ca.crt.
AGENT_MTLS_REQUIRED=true
AGENT_CERT_DIR=/var/lib/kq-agent/certs

AGENT_JOB_WORK_ROOT=/var/lib/kq-agent/jobs
AGENT_DATASET_ROOT=/var/lib/kq-agent/datasets
AGENT_LICENSED_MATERIAL_ROOT=/var/lib/kq-agent/licensed-materials
AGENT_SANDBOX_ROOT=/var/lib/kq-agent/sandbox

# Scheduler discovery uses PATH. Set the complete site-specific path here.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
AGENT_SPACK_ENABLED=false
# AGENT_SPACK_PATH=/opt/spack/bin/spack
