      "html": "<button class=\"ds-button ds-button-primary\" type=\"button\">主按钮</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;height:2.25rem;padding:0.5rem 1rem;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:0.875rem;font-weight:500;cursor:pointer;transition:color 150ms,background-color 150ms}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-button:disabled{pointer-events:none;opacity:0.5}.ds-button-primary{background:var(--brand);color:var(--brand-foreground)}.ds-button-primary:hover{background:color-mix(in oklab,var(--brand) 90%,transparent)}"
    },
