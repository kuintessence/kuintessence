# Add to a private deployment .env, alongside deploy/main/env.example.
# Absolute paths only. Private files are owned by the runtime UID, mode 0600.
KQ_IMAGE_TAG=main
FEDERATION_SITE_ID=
FEDERATION_SIGNING_KEY_ID=
FEDERATION_SIGNING_KEY_FILE=/etc/kuintessence/federation/signing.key
FEDERATION_TLS_CA_FILE=/etc/kuintessence/federation/server-ca.pem
FEDERATION_TLS_CERT_FILE=/etc/kuintessence/federation/server.pem
FEDERATION_TLS_KEY_FILE=/etc/kuintessence/federation/server.key
FEDERATION_CLIENT_CA_FILE=/etc/kuintessence/federation/client-ca.pem
FEDERATION_CLIENT_CERT_FILE=/etc/kuintessence/federation/client.pem
FEDERATION_CLIENT_KEY_FILE=/etc/kuintessence/federation/client.key
FEDERATION_TLS_BIND=127.0.0.1
FEDERATION_TLS_PORT=3443
# Fabric mode only. These package IDs come from approved lifecycle artifacts.
KQ_FABRIC_DIRECTORY=/etc/kuintessence/fabric
KQ_FABRIC_EVIDENCE_PACKAGE_ID=
KQ_FABRIC_COMMERCIAL_PACKAGE_ID=
KQ_FABRIC_MARKET_PACKAGE_ID=
KQ_FABRIC_CASE_PACKAGE_ID=
KQ_FABRIC_BIND=127.0.0.1
KQ_FABRIC_PEER_PORT=7051
KQ_FABRIC_ORDERER_PORT=7050
