      "css": ".ds-input{display:flex;height:2.25rem;width:100%;min-width:0;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--card);color:var(--foreground);padding:0.25rem 0.75rem;font-family:var(--font-sans);font-size:0.875rem}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-input:disabled{cursor:not-allowed;opacity:0.5}.ds-input[aria-invalid=true]{border-color:var(--status-failed)}"
