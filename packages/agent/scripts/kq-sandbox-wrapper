#!/bin/sh
# Installed by the CP as root:root 0755 at /usr/libexec/kuintessence/kq-sandbox-wrapper.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

readonly PROFILE_CONFIG=/etc/kuintessence/restricted-execution-profile.conf

die() {
  printf '%s\n' "kq-sandbox-wrapper: $*" >&2
  exit 126
}

secure_regular_file() {
  path=$1
  expected_hash=$2
  [ "$(realpath "$path")" = "$path" ] || die "non-canonical path: $path"
  [ -f "$path" ] && [ ! -L "$path" ] || die "not a regular file: $path"
  parent=$(dirname "$path")
  while :; do
    [ -d "$parent" ] && [ ! -L "$parent" ] || die "unsafe parent: $parent"
    [ "$(stat -c '%u' "$parent")" = 0 ] || die "parent not root-owned: $parent"
    parent_mode=$(stat -c '%a' "$parent")
    case "$parent_mode" in
      *[2367][0-7]|[0-7]*[2367]) die "parent group/world writable: $parent" ;;
    esac
    [ "$parent" = / ] && break
    parent=$(dirname "$parent")
  done
  owner=$(stat -c '%u' "$path")
  mode=$(stat -c '%a' "$path")
  [ "$owner" = 0 ] || die "not root-owned: $path"
  case "$mode" in
    *[2367][0-7]|[0-7]*[2367]) die "group/world writable: $path" ;;
  esac
  actual_hash=$(sha256sum "$path" | awk '{print $1}')
  [ "$actual_hash" = "$expected_hash" ] || die "sha256 mismatch: $path"
}

[ -r "$PROFILE_CONFIG" ] || die "profile config unavailable"
secure_regular_file "$PROFILE_CONFIG" "$(sha256sum "$PROFILE_CONFIG" | awk '{print $1}')"
# This file is root-owned and non-writable; its values are the local
# compute-node authority and are intentionally not inherited from the Agent.
. "$PROFILE_CONFIG"

[ "${KQ_PROFILE_ID:-}" ] || die "missing KQ_PROFILE_ID"
[ "${KQ_APPTAINER_PATH:-}" ] || die "missing KQ_APPTAINER_PATH"
[ "${KQ_APPTAINER_SHA256:-}" ] || die "missing KQ_APPTAINER_SHA256"
[ "${KQ_SIF_PATH:-}" ] || die "missing KQ_SIF_PATH"
[ "${KQ_SIF_SHA256:-}" ] || die "missing KQ_SIF_SHA256"
[ "${KQ_WRAPPER_PATH:-}" ] || die "missing KQ_WRAPPER_PATH"
[ "${KQ_WRAPPER_SHA256:-}" ] || die "missing KQ_WRAPPER_SHA256"
[ "${KQ_SECCOMP_PATH:-}" ] || die "missing KQ_SECCOMP_PATH"
[ "${KQ_SECCOMP_SHA256:-}" ] || die "missing KQ_SECCOMP_SHA256"
case "$KQ_SECCOMP_PATH" in
  /*) ;;
  *) die "seccomp path must be absolute" ;;
esac
case "$KQ_SECCOMP_PATH" in
  *','*|*':'*) die "seccomp path contains security option separators" ;;
esac

secure_regular_file "$KQ_WRAPPER_PATH" "$KQ_WRAPPER_SHA256"
secure_regular_file "$KQ_APPTAINER_PATH" "$KQ_APPTAINER_SHA256"
secure_regular_file "$KQ_SIF_PATH" "$KQ_SIF_SHA256"
secure_regular_file "$KQ_SECCOMP_PATH" "$KQ_SECCOMP_SHA256"
[ "$(realpath "$0")" = "$KQ_WRAPPER_PATH" ] || die "wrapper execution path mismatch"
sif_mode=$(stat -c '%a' "$KQ_SIF_PATH")
case "$sif_mode" in
  *[2367][0-7][0-7]|*[2367][0-7]|*[2367]) die "SIF must be readonly" ;;
esac

# Startup checks the same compute-node policy used immediately before exec.
if [ "$#" -eq 1 ] && [ "$1" = --check-profile ]; then exit 0; fi

[ $# -ge 15 ] || die "incomplete signed execution profile"
[ "$1" = --profile-id ] || die "profile id flag required"; profile_id=$2; shift 2
[ "$1" = --apptainer-path ] || die "apptainer path flag required"; apptainer_path=$2; shift 2
[ "$1" = --apptainer-sha256 ] || die "apptainer hash flag required"; apptainer_sha256=$2; shift 2
[ "$1" = --sif-path ] || die "SIF path flag required"; sif_path=$2; shift 2
[ "$1" = --sif-sha256 ] || die "SIF hash flag required"; sif_sha256=$2; shift 2
[ "$1" = --wrapper-sha256 ] || die "wrapper hash flag required"; wrapper_sha256=$2; shift 2
[ "$1" = -- ] || die "argv delimiter required"; shift

[ "$profile_id" = "$KQ_PROFILE_ID" ] || die "profile id mismatch"
[ "$apptainer_path" = "$KQ_APPTAINER_PATH" ] || die "Apptainer path mismatch"
[ "$apptainer_sha256" = "$KQ_APPTAINER_SHA256" ] || die "Apptainer hash mismatch"
[ "$sif_path" = "$KQ_SIF_PATH" ] || die "SIF path mismatch"
[ "$sif_sha256" = "$KQ_SIF_SHA256" ] || die "SIF hash mismatch"
[ "$wrapper_sha256" = "$KQ_WRAPPER_SHA256" ] || die "wrapper hash mismatch"

[ "$1" = "$KQ_APPTAINER_PATH" ] || die "unexpected execution binary"
shift
# Consume the Agent's exact prefix; the node supplies the mandatory seccomp policy.
for expected in exec --containall --cleanenv --no-home --no-eval --no-mount \
  hostfs,cwd,home --net --network none --drop-caps all --security no-new-privs --pwd /kq; do
  [ "$#" -gt 0 ] && [ "$1" = "$expected" ] || die "unexpected isolation argv"
  shift
done

validate_tail() {
  while [ "${1:-}" = --bind ]; do
    [ "$#" -ge 2 ] || die "missing bind path"
    case "$2" in
      *','*|*'/../'*|*'/./'*) die "ambiguous bind path" ;;
    esac
    case "$2" in
      /*:/kq/script/*:ro|/*:/kq/context.json:ro|/*:/kq/inputs/*:ro) ;;
      *) die "restricted execution requires readonly managed mounts" ;;
    esac
    shift 2
  done
  [ "$#" -eq 3 ] && [ "$1" = "$KQ_SIF_PATH" ] || die "unexpected runtime argv"
  case "$2" in
    /bin/bash|/usr/bin/python3|/usr/bin/node) ;;
    *) die "unexpected interpreter" ;;
  esac
  case "$3" in
    /kq/script/*) ;;
    *) die "unexpected script path" ;;
  esac
}
validate_tail "$@"
exec "$KQ_APPTAINER_PATH" exec --containall --cleanenv --no-home --no-eval \
  --no-mount hostfs,cwd,home --net --network none --drop-caps all \
  --security "no-new-privs,seccomp:$KQ_SECCOMP_PATH" --pwd /kq "$@"
