map $cookie_kq_preview $preview_allowed {
    default 0;
    "${PREVIEW_COOKIE}" 1;
}

map $http_authorization $preview_authorization {
    default $http_authorization;
    ~*^Basic "";
}

map $http_upgrade $preview_connection {
    default upgrade;
    "" close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log off;
    error_log /dev/stderr warn;
    absolute_redirect off;
    client_max_body_size 32m;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;

    # A static response runs after Basic auth; a return directive would bypass it.
    location = /__preview/unlock {
        auth_basic "Kuintessence preview";
        auth_basic_user_file /etc/nginx/preview.htpasswd;
        alias /usr/share/nginx/html/unlock.html;
        default_type text/html;
        add_header Set-Cookie "kq_preview=${PREVIEW_COOKIE}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=600";
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Keep the preview gate while allowing the same raw bundle limit as Registry.
    location = /software/api/spack/recipe-repositories/import {
        if ($preview_allowed = 0) {
            return 302 /__preview/unlock;
        }
        client_max_body_size 128m;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $preview_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $preview_connection;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Cache-Control;
    }

    location = /software/api/spack/upstream-imports {
        if ($preview_allowed = 0) {
            return 302 /__preview/unlock;
        }
        client_max_body_size 2m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $preview_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Cache-Control;
    }

    location ^~ /software/api/spack/material-repositories/ {
        if ($preview_allowed = 0) {
            return 302 /__preview/unlock;
        }
        client_max_body_size 16g;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $preview_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Cache-Control;
    }

    location / {
        if ($preview_allowed = 0) {
            return 302 /__preview/unlock;
        }
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $preview_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $preview_connection;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 65s;
        proxy_hide_header Cache-Control;
    }
}
