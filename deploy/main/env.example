# 在服务器上复制为 /opt/deploy/.env 并填写；CI 只覆盖 env.example。
# 此文件不含可用凭据。保留已有站点的数据库、密钥、卷和身份配置。
KQ_IMAGE_OWNER=kuintessence
POSTGRES_PASSWORD=
# 密码须与 POSTGRES_PASSWORD 一致；URL 中的特殊字符须做 percent-encoding。
DATABASE_URL=postgres://kq:REPLACE_WITH_ENCODED_PASSWORD@postgres:5432/kuintessence?sslmode=disable
JWT_SECRET=
AUTHZ_SPICEDB_TOKEN=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

WEB_BASE_URL=https://platform.example.com/
SSO_BOOTSTRAP_ISSUER_URL=https://sso.example.com
SSO_BOOTSTRAP_CLIENT_ID=kuintessence-server
SSO_BOOTSTRAP_CLIENT_SECRET=
SSO_BOOTSTRAP_REDIRECT_URI=https://platform.example.com/platform/api/auth/oidc/callback
SSO_BOOTSTRAP_GROUP_MAPPING='{"platform-admins":"super_admin","platform-users":"user"}'

# 仅填写会校验 Agent 客户端证书的代理实际来源 CIDR。
MTLS_TRUSTED_PROXY_CIDRS=
HTTP_TRUSTED_PROXY_CIDRS=
SPACK_MATERIAL_EPOCH=
LOG_LEVEL=info
WEB_HTTP_PORT=8080
SERVER_HTTP_PORT=3000
SERVER_GRPC_PORT=3001
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# 可选离线交付。目录只读挂载；不配置 OFFLINE_DELIVERY_SEED 时正常启动。
KQ_SEED_DIRECTORY=./seed
OFFLINE_DELIVERY_SEED=
# 启用时设置 /opt/kq-seed/delivery.json；subject 为已存在且未停用的服务用户 UUID。
OFFLINE_DELIVERY_SEED_SUBJECT=
ECOSYSTEM_RELEASE_TRUSTED_KEYS='{}'
