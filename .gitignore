# routeTree.gen.ts is generated by @tanstack/router-plugin during vite build.
# We commit it so `tsc -b` (which runs before vite in `bun run build`) sees a
# valid tree — the Docker build would otherwise fail with stale-tree type errors.
# Regenerated as a side effect of running `bun run build` locally.
packages/web/test-results/
packages/web/playwright-report/
packages/web/blob-report/
packages/web/playwright/.cache/
packages/web/coverage/
packages/*/bun.lock
.gstack/
.tanstack/
.worktrees/
packages/web/.claude/
