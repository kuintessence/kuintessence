# Server
DATABASE_URL=postgres://kq:kq@localhost:5432/kuintessence
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-must-be-32-chars-min
SERVER_PORT=3000
SERVER_GRPC_PORT=3001
LOG_LEVEL=info
# Optional development bootstrap only. Leave empty in production and configure
# authorized roots through Cluster File Roots in Settings.
CLUSTER_FILE_STATIC_ROOTS=

# Registry-only Spack upstream imports; never set HTTP_PROXY/ALL_PROXY for this feature.
# Inject the proxy URL from a secret store/private environment, not a tracked file.
SPACK_UPSTREAM_ENABLED=false
SPACK_UPSTREAM_PROXY_URL=
# Exact public HTTPS origins only, default port 443; no paths or credentials.
SPACK_UPSTREAM_ALLOWED_ORIGINS='[]'
SPACK_UPSTREAM_TIMEOUT_MS=300000
SPACK_UPSTREAM_IDLE_TIMEOUT_MS=30000
SPACK_UPSTREAM_MAX_CONCURRENT=2
SPACK_UPSTREAM_MAX_BYTES=1073741824
# Optional absolute path INSIDE Registry; mount the target TLS CA bundle read-only.
SPACK_UPSTREAM_CA_BUNDLE=

# Agent
SERVER_GRPC_URL=http://localhost:3001
AGENT_ID=agent-dev-01
AGENT_SITE_NAME=dev-cluster
AGENT_DB_PATH=./agent.db
HEARTBEAT_INTERVAL_SEC=30
AGENT_QUEUE_INVENTORY_INTERVAL_SEC=30

# RustFS / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=kuintessence-dev
