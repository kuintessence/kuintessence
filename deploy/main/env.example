# 在服务器上复制为 /opt/deploy/.env 并填写；CI 只覆盖 env.example。
# 此文件不含可用凭据。保留已有站点的数据库、密钥、卷和身份配置。
KQ_IMAGE_OWNER=kuintessence
POSTGRES_PASSWORD=
# 密码须与 POSTGRES_PASSWORD 一致；URL 中的特殊字符须做 percent-encoding。
DATABASE_URL=postgres://kq:REPLACE_WITH_ENCODED_PASSWORD@postgres:5432/kuintessence?sslmode=disable
JWT_SECRET=
AUTHZ_SPICEDB_TOKEN=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

WEB_BASE_URL=https://platform.example.com/
SSO_BOOTSTRAP_ISSUER_URL=https://sso.example.com
SSO_BOOTSTRAP_CLIENT_ID=kuintessence-server
SSO_BOOTSTRAP_CLIENT_SECRET=
SSO_BOOTSTRAP_REDIRECT_URI=https://platform.example.com/platform/api/auth/oidc/callback
SSO_BOOTSTRAP_GROUP_MAPPING='{"platform-admins":"super_admin","platform-users":"user"}'

# 仅填写会校验 Agent 客户端证书的代理实际来源 CIDR。
MTLS_TRUSTED_PROXY_CIDRS=
HTTP_TRUSTED_PROXY_CIDRS=
SPACK_MATERIAL_EPOCH=
LOG_LEVEL=info
WEB_HTTP_PORT=8080
SERVER_HTTP_PORT=3000
SERVER_GRPC_PORT=3001
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# 可选离线交付。目录只读挂载；不配置 OFFLINE_DELIVERY_SEED 时正常启动。
KQ_SEED_DIRECTORY=./seed
OFFLINE_DELIVERY_SEED=
# 启用时设置 /opt/kq-seed/delivery.json；subject 为已存在且未停用的服务用户 UUID。
OFFLINE_DELIVERY_SEED_SUBJECT=
ECOSYSTEM_RELEASE_TRUSTED_KEYS='{}'

# 站点发行：预先创建绝对路径目录，只读挂入 Server；仅含可公开发行的签名文件。
# 不挂载签名私钥。已有站点的目录和卷映射应保留，不能以模板覆盖。
KQ_SITE_RELEASES_DIRECTORY=/opt/deploy/site-releases

# 升级 main 前须补以下公共 origin 和两个独立密钥，缺失时 Compose 明确拒绝启动。
# 不覆盖现有 .env；保留旧站点专用密钥和所有既有站点配置。
# 原生 OCI：同一 HTTPS origin 提供 /v2/ 与 /api/registry/token，无 path/query。
REGISTRY_PUBLIC_ORIGIN=https://platform.example.com
# 必填独立 Registry 签名密钥，至少32字符；不得复用 JWT_SECRET。
# Server 与 Registry 必须使用相同值；已有专用密钥、issuer/audience不要轮换为模板值。
REGISTRY_JWT_SECRET=
REGISTRY_JWT_ISSUER=kuintessence-server
REGISTRY_JWT_AUDIENCE=kuintessence-registry

# 材料交付默认关闭；启用前准备准确 spec 的不可变材料绑定和 mTLS 入口。
SPACK_MATERIAL_DELIVERY_ENABLED=false
# 以下 HTTP 仅用于同一 Compose 私网；外部 Registry 改用 HTTPS 并关闭 insecure。
SPACK_REGISTRY_URL=http://registry:3100
SPACK_REGISTRY_ALLOW_INSECURE_HTTP=true
# 必填独立随机密钥，至少32字符，不得复用 JWT_SECRET 或 REGISTRY_JWT_SECRET。
SPACK_MATERIAL_TICKET_SECRET=
SPACK_MATERIAL_TICKET_TTL_SEC=900
SPACK_MATERIAL_RELEASES='{}'
