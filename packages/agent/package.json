{
  "name": "@kuintessence/agent",
  "license": "AGPL-3.0-only",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapters": {
      "bun": "./src/adapters/index.ts",
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    },
    "./monitor": {
      "bun": "./src/monitor/index.ts",
      "types": "./src/monitor/index.ts",
      "default": "./src/monitor/index.ts"
    },
    "./auth": {
      "bun": "./src/auth/index.ts",
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./embedded": {
      "bun": "./src/embedded/index.ts",
      "types": "./src/embedded/index.ts",
      "default": "./src/embedded/index.ts"
    },
    "./staging": {
      "bun": "./src/staging/index.ts",
      "types": "./src/staging/index.ts",
      "default": "./src/staging/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile=dist/kq-agent",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "2.1.1",
    "@kuintessence/db": "workspace:*",
    "@kuintessence/proto": "workspace:*",
    "@kuintessence/shared": "workspace:*",
    "node-forge": "^1.4.0",
    "pino": "^9.7.0",
    "ssh2": "^1.16.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/ssh2": "^1.15.0",
    "testcontainers": "^11.14.0"
  }
}
